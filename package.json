{
  "name": "folio",
  "private": true,
  "version": "1.0.0",
  "description": "FOLIO by ANVA — private, local-first personal finance planning",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "desktop": "npm run build && electron .",
    "package:windows": "npm run build && electron-builder --win nsis --x64",
    "android:sync": "npm run build && cap sync android",
    "android:build": "npm run android:sync && node scripts/android.mjs debug",
    "test:ui": "vitest run test/ui",
    "test:desktop": "electron scripts/desktop-smoke.cjs",
    "notices": "node scripts/notices.mjs",
    "test:android": "npm run android:sync && node scripts/android.mjs test",
    "icons": "node scripts/icons.mjs",
    "android:release": "npm run android:sync && node scripts/android.mjs release",
    "prebuild": "npm run notices"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/share": "^8.0.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^30.1.1",
    "sharp": "^0.35.5",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  },
  "author": "ANVA",
  "main": "desktop/main.cjs",
  "build": {
    "appId": "com.anva.folio",
    "productName": "Folio",
    "directories": {
      "output": "release/windows"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json",
      "THIRD-PARTY-NOTICES.txt"
    ],
    "win": {
      "target": "nsis",
      "signExecutable": false,
      "icon": "build/folio.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": null
  }
}
